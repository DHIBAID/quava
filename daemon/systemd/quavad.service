[Unit]
Description=Quava daemon
Requires=quavad.socket
After=quavad.socket network-online.target graphical-session.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/quavad
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
