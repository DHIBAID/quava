# This makefile is generated by the help of an LLM. I do not know how to write makefiles.

# ---- Config -----------------------------------------------------------------
PACKAGE  := com.dhibaid.quava
ACTIVITY := $(PACKAGE)/.MainActivity
JDK      := /usr/lib/jvm/java-21-openjdk
GRADLE   := ./gradlew
ADB      := adb

# Gradle needs to see the right JDK and SDK
export JAVA_HOME    := $(JDK)
export ANDROID_HOME := $(HOME)/Android/Sdk
export PATH         := $(JDK)/bin:$(ANDROID_HOME)/platform-tools:$(PATH)

APK := app/build/outputs/apk/debug/app-debug.apk

# Set DEVICE=<serial> to skip the picker, e.g.  make run DEVICE=R58M1234ABC
DEVICE ?=

.PHONY: build apk install run debug restart stop logs logs-app test clean \
        devices uninstall reverse forward stop-gradle

# ---- Build ------------------------------------------------------------------
build apk:
	$(GRADLE) assembleDebug
	@ls -lh $(APK)

test:
	$(GRADLE) test

clean:
	$(GRADLE) clean

stop-gradle:
	$(GRADLE) --stop

# ---- Device selection -------------------------------------------------------
# Picks a device once and writes the serial to .device (gitignored).
# Skipped if DEVICE= is given, or if only one device is connected.
.device: FORCE
	@if [ -n "$(DEVICE)" ]; then \
		echo "$(DEVICE)" > $@; exit 0; \
	fi; \
	devices=$$($(ADB) devices | awk 'NR > 1 && $$2 == "device" { print $$1 }'); \
	count=$$(echo "$$devices" | grep -c .); \
	if [ "$$count" -eq 0 ]; then \
		echo "No devices connected."; exit 1; \
	elif [ "$$count" -eq 1 ]; then \
		echo "$$devices" > $@; \
	else \
		echo "Select device:"; \
		select device in $$devices; do \
			if [ -n "$$device" ]; then echo "$$device" > $@; break; \
			else echo "Invalid selection."; fi; \
		done; \
	fi

FORCE:

# Convenience: every adb call below targets the chosen device
ADBD = $(ADB) -s $$(cat .device)

devices:
	$(ADB) devices -l

# ---- Install / run ----------------------------------------------------------
install: apk .device
	@echo "Installing on $$(cat .device)"
	$(ADBD) install -r -d $(APK)

run: install
	$(ADBD) shell am start -n $(ACTIVITY)

# Launch and wait for a debugger to attach
debug: install
	$(ADBD) shell am start -D -n $(ACTIVITY)

stop: .device
	$(ADBD) shell am force-stop $(PACKAGE)

restart: stop
	$(ADBD) shell am start -n $(ACTIVITY)

uninstall: .device
	$(ADBD) uninstall $(PACKAGE)

# ---- Logs -------------------------------------------------------------------
logs: .device
	$(ADBD) logcat -T 1 -s Quava:V AndroidRuntime:E

logs-app: .device
	$(ADBD) logcat --pid=$$($(ADBD) shell pidof -s $(PACKAGE))

# ---- Port mapping for your Go responder -------------------------------------
reverse: .device
	$(ADBD) reverse tcp:48274 tcp:48274

forward: .device
	$(ADBD) forward tcp:48273 tcp:48273