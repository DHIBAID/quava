<?xml version="1.0" encoding="utf-8"?>
<!-- Keep pairing identity and SSH authentication material on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="quava-pairing.xml" />
        <exclude domain="sharedpref" path="quava-ssh.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quava-pairing.xml" />
        <exclude domain="sharedpref" path="quava-ssh.xml" />
    </device-transfer>
</data-extraction-rules>
