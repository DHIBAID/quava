# This makefile is generated by the help of an LLM. I do not know how to write makefiles.

CC := gcc
PKG_CONFIG := pkg-config

TARGET := quava
BUILD_DIR := build
SRC_DIR := src

SOURCES := $(shell find $(SRC_DIR) -type f -name '*.c')
OBJECTS := $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SOURCES))

CFLAGS += -Wall -Wextra -Wpedantic -O2
CFLAGS += $(shell $(PKG_CONFIG) --cflags gtk4 json-glib-1.0 gio-unix-2.0)
LDLIBS += $(shell $(PKG_CONFIG) --libs gtk4 json-glib-1.0 gio-unix-2.0)

.PHONY: all build run clean

all: build

build: $(BUILD_DIR)/$(TARGET)

$(BUILD_DIR)/$(TARGET): $(OBJECTS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

run: build
	./$(BUILD_DIR)/$(TARGET)

clean:
	rm -rf $(BUILD_DIR)
