<?xml version="1.0" encoding="utf-8"?>
<!-- Keep pairing identity material on this device. SSH credentials are
     never persisted at all (see SshTerminal.kt), so there's nothing to
     exclude for them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="quava-pairing.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quava-pairing.xml" />
    </device-transfer>
</data-extraction-rules>
